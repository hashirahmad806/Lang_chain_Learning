# Groq Cloud API Key (Get yours at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Default Model and Provider configuration for init_chat_model
MODEL="openai/gpt-oss-120b"
MODEL_PROVIDER="groq"

# MongoDB Connection URI (for RAG vector store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# Voyage AI API Key (for Voyage-3.5-lite embeddings)
VOYAGE_API_KEY=your_voyage_api_key_here

# OpenAI API Key (for metadata tagging and ChatOpenAI)
LLM_API_KEY=your_openai_api_key_here
